# ---------------------------------------------------------------------------
# KYC-SYNC environment configuration
# Copy this file to .env and fill in real values for local development.
# Never commit your actual .env file.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
# Local Docker Compose default:
DATABASE_URL="postgresql://kycsync:kycsync@localhost:5432/kycsync?schema=public"

# Secret used to sign session (JWT) cookies and MFA challenge tokens.
# Generate a strong random value, e.g.: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-characters"

# When true (default), the app runs in DEMO MODE:
#  - the admin MFA/OTP code is returned in the login API response so the
#    hackathon flow can be completed without a real SMS/authenticator setup
#  - demo banners are shown across the admin dashboard
# Set to "false" for a production-style deployment.
DEMO_MODE="true"

NODE_ENV="development"
